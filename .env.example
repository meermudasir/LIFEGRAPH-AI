# LifeGraph AI - Environment Configuration Template
APP_NAME=LifeGraph AI
VERSION=2.4.0
ENVIRONMENT=development
DEBUG=True

# Server Bind Settings
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite for local lightweight student development)
DATABASE_URL=sqlite:///./lifegraph.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000,http://127.0.0.1:5500,null

# Analytics & Vector Engine Settings
VECTOR_MAX_FEATURES=2048
DEFAULT_SIMILARITY_THRESHOLD=0.80
DEFAULT_TOP_K=10
LOG_LEVEL=INFO
