# LifeGraph AI - Environment Configuration Template
APP_NAME=LifeGraph AI
VERSION=2.4.0
ENVIRONMENT=development
DEBUG=True

# Server Bind Settings
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite for local lightweight student development; PostgreSQL in production)
DATABASE_URL=sqlite:///./lifegraph.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000,http://127.0.0.1:5500,null

# Multi-User Authentication & Session Security
# Generate a strong random key in production: openssl rand -hex 32
SECRET_KEY=lifegraph-insecure-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=lifegraph_session
OAUTH_STATE_COOKIE_NAME=lifegraph_oauth_state
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy Data Ownership Mapping
# Existing unassigned graph records will be mapped to this designated account during migration
LEGACY_OWNER_EMAIL=admin@lifegraph.local
LEGACY_OWNER_NAME=Mudasir Reyaz

# Analytics & Vector Engine Settings
VECTOR_MAX_FEATURES=2048
DEFAULT_SIMILARITY_THRESHOLD=0.80
DEFAULT_TOP_K=10
LOG_LEVEL=INFO
